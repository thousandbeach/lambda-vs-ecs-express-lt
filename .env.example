# =============================================================================
# .env.example — このファイルは git にコミット OK の "テンプレート"。
#
# 使い方:
#   1. cp .env.example .env
#   2. .env を編集して実際のキーを入れる(値は決して git に commit しない)
#   3. generate_audio_*.py を実行 → 自動で .env を読みに行く (python-dotenv 経由)
#
# .gitignore で /.env /.env.local /.env.*.local は除外済み。
# .env.example だけが追跡対象。
# =============================================================================

# OpenAI TTS の API キー (`gpt-4o-mini-tts` で `audio/` `audio-ecs/` の mp3 生成に使用)
OPENAI_API_KEY=sk-replace-this-with-your-actual-key

# (将来 ECS の PUBLIC_URL を手動で上書きしたい時の予備。未指定なら bin/ecs-app.ts のデフォルト)
# LT_PUBLIC_URL=https://lt-16808a3125334d3f993982859eaf40f6.ecs.ap-northeast-1.on.aws

# (CDK のリージョン上書き。未指定なら bin/*.ts ハードコードの ap-northeast-1)
# LT_REGION=ap-northeast-1
